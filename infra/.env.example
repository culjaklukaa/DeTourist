# DeTourist — Local Infrastructure Environment Variables
# Copy this file to .env and adjust as needed.
# All values below are the defaults used by docker-compose.yml.

# ── PostgreSQL + PostGIS ──────────────────────────────────────
POSTGRES_USER=detourist
POSTGRES_PASSWORD=detourist_dev
POSTGRES_DB=detourist
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Meilisearch ───────────────────────────────────────────────
MEILI_MASTER_KEY=detourist_meili_dev_key
MEILI_PORT=7700
